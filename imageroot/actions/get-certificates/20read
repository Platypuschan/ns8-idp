#!/usr/bin/env python3
import json
import os
import sys
import agent
import idpcert
import idprealm
import kcadmin

request = json.load(sys.stdin)
idprealm.require_keycloak()
with idprealm.realms_lock():
    kc = kcadmin.agent_client()
    domain = request['domain']
    if domain not in kcadmin.managed_realms(kc):
        idprealm.fail_validation('domain', domain, 'realm_not_found')
    rep = kc.get('/' + idpcert.path(domain))
    # Traefik updates can replace the patched proxy: report what really works.
    operational = idpcert.operational_flow(rep) and \
        agent.get_route(os.environ['MODULE_ID']).get('client_certificates') is True
    json.dump({'enabled': idpcert.enabled(rep), 'operational': operational, 'certificates': [
        {'fingerprint': key, **value} for key, value in sorted(idpcert.records(rep).items())
    ]}, sys.stdout)
