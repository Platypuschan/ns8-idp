# Route the whole host name to Keycloak. If the Let's Encrypt
# certificate is not obtained, the action fails with the Traefik error
# and Traefik keeps the previous route: the next steps save the new
# settings only after the route is set.

import json
import os
import sys

import agent
from idp_routes import certificate_transport, restrict_admin

request = json.load(sys.stdin)
certificate_active = agent.get_route(os.environ['MODULE_ID']).get('client_certificates', False)

agent.set_route({
    "instance": os.environ["MODULE_ID"],
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "host": request["host"],
    "http2https": True,
    "lets_encrypt": request.get("lets_encrypt", False),
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
})

restrict_admin(request["host"], request.get("lets_encrypt", False))

# Preserve certificate transport when the hostname/LE setting changes.
# This action also runs with Keycloak stopped: consult the existing route,
# then keycloak-post-start reconciles the authoritative realm state.
if certificate_active or os.path.isfile('x509-proxy-secret'):
    certificate_transport(certificate_active, request['host'], request.get('lets_encrypt', False))
