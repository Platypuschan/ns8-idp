{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "alter-certificates input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "operation": {
      "enum": [
        "enable",
        "disable",
        "enroll",
        "revoke"
      ]
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "certificate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "domain",
    "operation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "enroll"
          }
        }
      },
      "then": {
        "required": [
          "username",
          "label",
          "certificate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "revoke"
          }
        }
      },
      "then": {
        "required": [
          "fingerprint"
        ]
      }
    }
  ]
}
