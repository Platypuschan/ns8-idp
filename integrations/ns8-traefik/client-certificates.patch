+
+if data.get('client_certificates'):
+    config['tls'] = {'options': {'ns8-client-certificates': {
+        'minVersion': 'VersionTLS12', 'clientAuth': {'clientAuthType': 'RequestClientCert'}}}}
 
 if middlewares:
